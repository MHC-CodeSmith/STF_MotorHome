FoamFile {version 2.0; format ascii; class dictionary; object fvSolution;}

solvers {
 p {solver PCG; preconditioner DIC; tolerance 1e-7; relTol .05; maxIter 500;}
 "(U|k|omega)" {solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol .1;}
}
SIMPLE {nNonOrthogonalCorrectors 2; consistent no;
 residualControl {p 1e-4; U 1e-5; "(k|omega)" 1e-5;}}
relaxationFactors {fields {p .1;} equations {U .25; k .25; omega .25;}}
